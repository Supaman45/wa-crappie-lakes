{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "functions": {
    "api/escapement.js": {
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/**",
      "maxDuration": 60,
      "memory": 1024
    },
    "api/watch.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/watch",
      "schedule": "0 15 * * *"
    }
  ]
}